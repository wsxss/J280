//=============================================================================
//  File        : j280.sdc
//  Brief       : J280 时序约束
//  Note        : 板上 50MHz 晶振，周期 20ns。
//                编码器/按键均为异步输入，模块内部已做同步处理，
//                此处只约束系统主时钟。
//=============================================================================

create_clock -name clk_50m -period 20 -waveform {0 10} [get_ports {clk_50m}]
